SECRET_KEY=replace-this-with-a-secure-secret-key-at-least-50-characters-long
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CORS_ORIGIN_ALLOW_ALL=False

# Database Configuration (for production with PostgreSQL)
DB_ENGINE=django.db.backends.postgresql_psycopg2
DB_NAME=hti_vip
DB_USER=hti
DB_PASSWORD=change-this-secure-password
DB_HOST=localhost
DB_PORT=5432

# Celery Configuration (optional - for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
